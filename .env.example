# Browser-safe Supabase configuration (Vite build-time variables)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# AI Gateway (server-side only)
LOVABLE_API_KEY=replace-with-server-only-ai-gateway-key

# Optional cron authentication secrets (server-side only)
LOVABLE_CRON_SECRET=replace-with-random-secret
LOVABLE_CRON_SECRET_PREVIOUS=

# Optional migration-only connection string; do not use in normal app runtime
LOVABLE_DB_MIGRATION_URL=

# Optional Azure AI Foundry OpenAI-compatible chat provider (server-side only).
# Leave OMNIFLOW_AI_PROVIDER unset (or "lovable") to keep the current Claude route.
# Azure routing is enabled only when OMNIFLOW_AI_PROVIDER=azure-foundry.
OMNIFLOW_AI_PROVIDER=lovable
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=replace-with-server-only-foundry-key
AZURE_FOUNDRY_MODEL=your-model-deployment-name
